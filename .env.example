# ── How registration works ───────────────────────────────────────────────
# 'modal'  (default) the built-in form opens in a dialog and writes to Supabase
# 'google'           every button reopens the old Google Form in a new tab
NEXT_PUBLIC_REGISTER_MODE=modal

# ── Supabase: the source of truth ────────────────────────────────────────
# Dashboard → Project Settings → API. Run supabase/registrations.sql first.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security, so it is server-only —
# never rename it to NEXT_PUBLIC_ANYTHING.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Sheets: the mirror (optional) ─────────────────────────────────
# Deploy scripts/sheets-webhook.gs as an Apps Script Web App and paste its
# /exec URL here. If this is unset the mirror is skipped; if it fails the
# registration still succeeds.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# ── Where registrants go next ────────────────────────────────────────────
# The WhatsApp community invite shown on the success screen. Until it is set
# the success screen simply omits the button.
NEXT_PUBLIC_WHATSAPP_URL=

# ── The old Google Form ──────────────────────────────────────────────────
# Kept as the fallback: it powers 'google' mode, and the modal offers it as an
# escape hatch after a submission has failed twice.
NEXT_PUBLIC_REGISTER_URL=https://docs.google.com/forms/d/e/FORM_ID/viewform
